{
  "name": "@nexathon/remediator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "smoke:e2b": "bun run src/smoke.ts",
    "smoke:fixture": "bun run src/fixture-smoke.ts",
