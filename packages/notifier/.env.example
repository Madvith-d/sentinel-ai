# Local controller/notifier environment only. Never prefix this with VITE_.
# Email is the notification channel. Leave these empty until the mail account is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# Optional. Used only when SMTP_HOST is unset.
SLACK_WEBHOOK_URL=
