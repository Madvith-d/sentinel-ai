# Local controller/notifier environment only. Never prefix this with VITE_.
# Email transport is configured in apps/controller/.env. SMTP_TO is set by the user in controller settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional. Used only when SMTP_HOST is unset.
SLACK_WEBHOOK_URL=
