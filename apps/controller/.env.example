# Monitoring is off by default. Never commit real credentials.
CONTROLLER_MONITOR_ENABLED=false
CONTROLLER_ROLLBACK_ENABLED=false
CONTROLLER_ROLLBACK_PROJECT_ID=
CONTROLLER_PLATFORM=vercel
CONTROLLER_REMEDIATION_ENABLED=false
CONTROLLER_POLL_INTERVAL_MS=30000
CONTROLLER_PROBE_PATH=/api/tasks
CONTROLLER_PORT=8787
INCIDENT_DB_PATH=./data/incidents.sqlite

# Configure only for the dedicated demo Vercel project.
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_PRODUCTION_DOMAIN=
VERCEL_TEAM_ID=

# Configure one alternative platform when CONTROLLER_PLATFORM selects it.
# Railway uses a service-scoped ID for monitoring/rollback and logs are queried
# through Railway's GraphQL API.
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_PRODUCTION_URL=

# Render log queries need the workspace owner ID as well as the service ID.
RENDER_API_KEY=
RENDER_OWNER_ID=
RENDER_SERVICE_ID=
RENDER_PRODUCTION_URL=

# For self-hosted Coolify, use the trusted control-plane origin (without /api/v1).
COOLIFY_API_TOKEN=
COOLIFY_BASE_URL=
COOLIFY_APPLICATION_ID=
COOLIFY_PRODUCTION_URL=

# Trusted fix-PR configuration. Required only when remediation is enabled.
REMEDIATOR_REPOSITORY=iotserver24/nexathon
REMEDIATOR_SETUP_COMMAND=bun install --frozen-lockfile --filter ./apps/sample
REMEDIATOR_REPRODUCE_COMMAND=bun test apps/sample/tests/filter.repro.test.ts
REMEDIATOR_TEST_COMMAND=bun run --cwd apps/sample test
REMEDIATOR_BUILD_COMMAND=bun run --cwd apps/sample build
REMEDIATOR_FIXTURE_PATH=apps/sample/tests/filter.repro.test.ts
REMEDIATOR_FIXTURE_SOURCE=packages/remediator/fixtures/task-filter.repro.ts.txt
REMEDIATOR_MODEL_NAME=dedicated-remediator
REMEDIATOR_MODEL_ID=
REMEDIATOR_MODEL_BASE_URL=
REMEDIATOR_MODEL_API_BACKEND=responses
REMEDIATOR_MODEL_API_KEY=
GITHUB_READ_TOKEN=
SLACK_WEBHOOK_URL=
